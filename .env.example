PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=

# Existing n8n forwarding flow. Keep this configured in production.
N8N_WEBHOOK_URL=

# Postmark outbound email. Do not commit real tokens.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=admin@stonebellisimollc.com
POSTMARK_MESSAGE_STREAM=outbound
POSTMARK_MOCK_MODE=true

# Feedback links, inbound reply parsing, and webhook protection.
FEEDBACK_TOKEN_SECRET=local-development-feedback-token-secret
FEEDBACK_DELAY_DAYS=7
FEEDBACK_TOKEN_TTL_DAYS=90
POSTMARK_INBOUND_SECRET=local-dev-inbound-secret
POSTMARK_WEBHOOK_SECRET=
POSTMARK_FEEDBACK_REPLY_DOMAIN=stonebellisimollc.com

# Business routing.
BUSINESS_NOTIFICATION_EMAIL=cesaryunda@hotmail.com
BUSINESS_REPLY_TO_EMAIL=cesaryunda@hotmail.com

# Local abuse limits.
CONTACT_RATE_LIMIT=8
FEEDBACK_BATCH_LIMIT=25
FEEDBACK_MAX_ATTEMPTS=8
