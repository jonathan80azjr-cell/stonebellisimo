PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=

# Postmark outbound email. Do not commit real tokens.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=admin@stonebellisimollc.com
POSTMARK_MESSAGE_STREAM=outbound
POSTMARK_MOCK_MODE=true

# Feedback links, inbound reply parsing, and webhook protection.
FEEDBACK_TOKEN_SECRET=local-development-feedback-token-secret
FEEDBACK_DELAY_DAYS=7
FEEDBACK_TOKEN_TTL_DAYS=90
POSTMARK_INBOUND_SECRET=local-dev-inbound-secret
POSTMARK_WEBHOOK_SECRET=
POSTMARK_FEEDBACK_REPLY_DOMAIN=stonebellisimollc.com
POSTMARK_TEST_EMAIL=you@example.com

# Business routing.
BUSINESS_NOTIFICATION_EMAIL=cesaryunda@hotmail.com
BUSINESS_REPLY_TO_EMAIL=cesaryunda@hotmail.com

# Staff alerts (new lead, unanswered reply, bounce, send failure, weekly
# digest). Recipients default to the admin allowlist in src/admin-accounts.mjs
# plus SB_ADMIN_EMAILS. SB_NOTIFY_EMAILS replaces that list outright when
# alerts belong somewhere else; set ADMIN_NOTIFICATIONS_ENABLED=false to mute.
ADMIN_NOTIFICATIONS_ENABLED=true
SB_NOTIFY_EMAILS=
NO_LEADS_ALERT_HOURS=72

# Local abuse limits.
CONTACT_RATE_LIMIT=8
FEEDBACK_BATCH_LIMIT=25
FEEDBACK_MAX_ATTEMPTS=8

VITE_GOOGLE_MAPS_API_KEY=

# Firebase public web configuration (not secrets). Use a Blaze project for
# Functions deployment and an App Check reCAPTCHA Enterprise web app.
SB_FIREBASE_PROJECT_ID=
SB_FIREBASE_WEB_API_KEY=
SB_FIREBASE_AUTH_DOMAIN=
SB_FIREBASE_APP_ID=
SB_FIREBASE_APPCHECK_SITE_KEY=

# Extra dashboard administrators, comma separated. Adds to the allowlist in
# src/admin-accounts.mjs; it can never remove an address from it.
SB_ADMIN_EMAILS=
APP_CHECK_ENFORCED=false
FUNCTIONS_SERVICE_ACCOUNT=

# Cloudflare -> Firebase Functions streaming proxy. Configure the same random
# value in Firebase Secret Manager and as a Cloudflare Worker secret.
FIREBASE_API_ORIGIN=
SB_PROXY_SECRET=

# Search Console reads sc-domain:stonebellisimollc.com with the Functions
# runtime service account. Google may omit anonymized/low-volume query rows.
SEARCH_CONSOLE_SITE_URL=sc-domain:stonebellisimollc.com
SEARCH_CONSOLE_LAG_DAYS=2
