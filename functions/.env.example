ENVIRONMENT=production
PUBLIC_SITE_URL=https://stonebellisimollc.com
POSTMARK_FROM_EMAIL=admin@stonebellisimollc.com
POSTMARK_MESSAGE_STREAM=outbound
POSTMARK_FEEDBACK_REPLY_DOMAIN=stonebellisimollc.com
BUSINESS_NOTIFICATION_EMAIL=cesaryunda@hotmail.com
BUSINESS_REPLY_TO_EMAIL=cesaryunda@hotmail.com
FEEDBACK_DELAY_DAYS=7
GOOGLE_PLACE_ID=ChIJVbaFyYZXwokRgfG3kFqd5MY
GOOGLE_REVIEWS_LIMIT=5
GOOGLE_REVIEWS_CACHE_SECONDS=900
SEARCH_CONSOLE_SITE_URL=sc-domain:stonebellisimollc.com
SEARCH_CONSOLE_LAG_DAYS=2
APP_CHECK_ENFORCED=false
FUNCTIONS_SERVICE_ACCOUNT=
SB_FIREBASE_PROJECT_ID=
SB_FIREBASE_WEB_API_KEY=
SB_FIREBASE_AUTH_DOMAIN=
SB_FIREBASE_APP_ID=
SB_FIREBASE_APPCHECK_SITE_KEY=
SB_ADMIN_EMAILS=

# Staff alerts. Recipients default to the admin allowlist; SB_NOTIFY_EMAILS
# overrides it and ADMIN_NOTIFICATIONS_ENABLED=false mutes every alert.
ADMIN_NOTIFICATIONS_ENABLED=true
SB_NOTIFY_EMAILS=
NO_LEADS_ALERT_HOURS=72
