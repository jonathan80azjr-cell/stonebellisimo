rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The browser never talks to Firestore directly. Public writes and every
    // admin read go through Firebase Functions, which validates App Check,
    // origins, and the admin custom claim before using the Admin SDK.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
