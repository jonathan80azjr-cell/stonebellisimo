{
  "name": "stone-bellisimo-2",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "homepage": "https://jonathan80azjr-cell.github.io/stonebellisimo",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "check": "npm run secrets:check && node --check server.js && node --check cloudflare-worker.mjs && node --check src/lead-automation.mjs && node --check src/email/render.mjs && node --check scripts/send-test-email.mjs && node --check scripts/check-no-secrets.mjs",
    "email:test": "node scripts/send-test-email.mjs",
    "worker:dev": "wrangler dev --test-scheduled",
    "worker:d1:create": "wrangler d1 create stonebellisimo-leads",
    "worker:d1:migrate": "wrangler d1 migrations apply stonebellisimo-leads --remote",
    "worker:d1:migrate:local": "wrangler d1 migrations apply stonebellisimo-leads --local",
    "predeploy": "gh-pages-clean",
    "deploy": "gh-pages -d public --message \"Deploy latest site\"",
    "deploy:worker": "wrangler deploy",
    "ship": "read -r -p \"Commit message [Ship latest changes]: \" message; message=${message:-Ship latest changes}; git add . && npm run secrets:check && git commit -m \"$message\" && git push && npm run deploy:worker",
    "secrets:check": "node scripts/check-no-secrets.mjs",
    "worker:secret": "wrangler secret put N8N_WEBHOOK_URL",
    "worker:secret:postmark": "wrangler secret put POSTMARK_SERVER_TOKEN",
    "worker:secret:feedback": "wrangler secret put FEEDBACK_TOKEN_SECRET",
    "worker:secret:inbound": "wrangler secret put POSTMARK_INBOUND_SECRET",
    "worker:secret:webhook": "wrangler secret put POSTMARK_WEBHOOK_SECRET"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "wrangler": "^4.50.0"
  }
}
